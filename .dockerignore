# ── Version control ───────────────────────────────────────────────────────────
.git
.github
.gitignore

# ── Dev tools / IDE ───────────────────────────────────────────────────────────
.vscode
.idea
*.swp
*.swo

# ── PHP dependencies (installed in builder stage) ─────────────────────────────
vendor/

# ── Node dependencies (installed in assets stage) ─────────────────────────────
node_modules/

# ── Built assets (rebuilt in assets stage) ────────────────────────────────────
public/build/

# ── Docker data (local bind-mount DB files – never bake into image) ───────────
.docker/data/

# ── Symfony runtime / cache ───────────────────────────────────────────────────
var/

# ── Test & QA artefacts ───────────────────────────────────────────────────────
build/coverage
build/reports
.phpunit.result.cache
.php-cs-fixer.cache
.php-cs-cache

# ── Environment files with secrets ────────────────────────────────────────────
.env.local
.env.*.local
.env.local.php

# ── DB dumps ─────────────────────────────────────────────────────────────────
*.sql

# ── OS cruft ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
