# Docker environment template for production deployments.
# Copy to .env.docker (or pass directly as shell env), then run:
#
#   docker compose --env-file .env.docker up -d
#
# NEVER commit the populated file.

# ── Symfony ───────────────────────────────────────────────────────────────────
APP_ENV=prod
APP_SECRET=change_me_32_char_random_string

# ── Database ──────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change_me_strong_password
MYSQL_DATABASE=byte_artist
DATABASE_URL="mysql://root:change_me_strong_password@mysql:3306/byte_artist?serverVersion=8.4&charset=utf8mb4"

# ── Ports (optional overrides) ────────────────────────────────────────────────
HTTP_PORT=8280
# MYSQL_PORT=3306   # only needed in override / dev

# ── Build UID/GID (should match the host user running docker compose) ─────────
USER_ID=1000
GROUP_ID=1000
